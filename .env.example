# Environment configuration for HPC Resource Optimization

# Database
DATABASE_URL=sqlite:///data/metrics.db
# For production: postgresql://user:pass@host:5432/dbname

# AWS Configuration (for tomorrow's cluster deployment)
AWS_REGION=us-east-1
AWS_PROFILE=default

# Parallel Cluster Configuration
CLUSTER_NAME=hpc-resource-opt
CLUSTER_REGION=us-east-1

# Model Configuration
MODEL_PATH=prediction/trained_model.pkl
MODEL_ALPHA=1.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Monitoring Configuration
SAMPLING_INTERVAL=1.0
METRICS_DIR=data/metrics

# SLURM Configuration (for cluster)
SLURM_PARTITION=compute
SLURM_QOS=normal

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::parallelcluster-e140fb2097b14600-v1-do-not-delete"
    },
    {
      "Sid": "AllowGetObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::parallelcluster-e140fb2097b14600-v1-do-not-delete/*"
    },
    {
      "Sid": "AllowPutObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::parallelcluster-e140fb2097b14600-v1-do-not-delete/hpc-learning-results/*"
    }
  ]
}
